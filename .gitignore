# Python
__pycache__/
*.pyc
.venv/
venv/

# backend/ml/artifacts/ NAO e' versionado: o scraper agendado publica os
# artefatos na GitHub Release "artifacts-latest" (sobrescrita a cada
# execucao, sem historico no git). O backend baixa de la' via
# ARTIFACTS_BASE_URL. Para rodar local sem baixar, rode `python -m ml.train`.
backend/ml/artifacts/*.joblib
backend/ml/artifacts/*.csv
backend/ml/artifacts/*.json

# Node / Next.js (web/)
web/node_modules/
web/.next/
web/out/
web/.env*.local

# Vercel
.vercel/

# Scraper browser profile (local Playwright session data)
scraper/.pw-profile/

# Editor / OS
.vscode/
.DS_Store
Thumbs.db

# Backups gerados por finalize.py (nao versionar)
*.bak
